{
  "schema_version": "3",
  "project": "Codex Engineering Governance Framework",
  "assurance": {
    "maturity": "M2",
    "level": "SA1",
    "facts": {
      "has_dependencies": false,
      "has_exposed_web_surface": false,
      "has_container_artifact": false,
      "has_iac": false,
      "has_persisted_data": false,
      "ships_distributable_artifact": true
    },
    "capabilities": [
      {
        "id": "lint-format",
        "decision": "REQUIRED",
        "reason": "Normative/source structure must be validated.",
        "checks": [
          "governance-static"
        ]
      },
      {
        "id": "type-compile",
        "decision": "REQUIRED",
        "reason": "Distributed Python tooling must compile.",
        "checks": [
          "python-compile"
        ]
      },
      {
        "id": "tests",
        "decision": "REQUIRED",
        "reason": "Assurance plus unified host/project lifecycle behavior are release-critical.",
        "checks": [
          "assurance-integration",
          "lifecycle-common",
          "lifecycle-windows",
          "lifecycle-posix"
        ]
      },
      {
        "id": "build-package",
        "decision": "REQUIRED",
        "reason": "The ZIP distribution must match the declared manifest.",
        "checks": [
          "manifest-package"
        ]
      },
      {
        "id": "secret-scan",
        "decision": "REQUIRED",
        "reason": "Distributed scripts/workflows must be checked for committed secrets.",
        "checks": [
          "secret-scan"
        ]
      },
      {
        "id": "sast",
        "decision": "REQUIRED",
        "reason": "Python, POSIX, PowerShell, and GitHub Actions surfaces require appropriate static security analysis.",
        "checks": [
          "sast-python",
          "sast-posix",
          "sast-powershell",
          "workflow-security"
        ]
      },
      {
        "id": "sca",
        "decision": "NOT_APPLICABLE",
        "reason": "No committed third-party runtime/build/dev dependency graph exists; scanner acquisition is separately integrity-pinned.",
        "checks": []
      },
      {
        "id": "security-tests",
        "decision": "REQUIRED",
        "reason": "Scanner configurations must prove positive and negative behavior.",
        "checks": [
          "scanner-regressions-linux",
          "scanner-regressions-windows"
        ]
      },
      {
        "id": "sbom",
        "decision": "OPTIONAL",
        "reason": "Reassess before 1.0 if the approved publication channel makes an SBOM materially useful or required.",
        "checks": []
      },
      {
        "id": "container-scan",
        "decision": "NOT_APPLICABLE",
        "reason": "The framework does not build or distribute a container artifact.",
        "checks": []
      },
      {
        "id": "iac-scan",
        "decision": "NOT_APPLICABLE",
        "reason": "The repository contains no deployment infrastructure-as-code.",
        "checks": []
      },
      {
        "id": "dast",
        "decision": "NOT_APPLICABLE",
        "reason": "There is no network-facing application/service surface.",
        "checks": []
      },
      {
        "id": "fuzz",
        "decision": "OPTIONAL",
        "reason": "No current parser/native-code risk justifies fuzzing as a release requirement at SA1.",
        "checks": []
      },
      {
        "id": "recovery-verification",
        "decision": "NOT_APPLICABLE",
        "reason": "The package has no persisted operational service data/state requiring recovery testing.",
        "checks": []
      },
      {
        "id": "provenance-signing",
        "decision": "OPTIONAL",
        "reason": "Source+artifact-digest+evidence binding is required now; signing/stronger provenance activates when the publication channel is approved.",
        "checks": []
      }
    ]
  },
