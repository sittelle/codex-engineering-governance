{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-governance/verification-plan-v3.schema.json",
  "title": "Governed Verification Plan v3",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "assurance",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "assurance": {
      "type": "object",
      "required": [
        "maturity",
        "level",
        "facts",
        "capabilities"
      ],
      "properties": {
        "maturity": {
          "enum": [
            "M0",
            "M1",
            "M2",
            "M3"
          ]
        },
        "level": {
          "enum": [
            "SA0",
            "SA1",
            "SA2",
            "SA3"
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "decision",
              "checks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "decision": {
                "enum": [
                  "REQUIRED",
                  "OPTIONAL",
                  "NOT_APPLICABLE",
                  "UNRESOLVED"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "checks": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stages",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "quick",
                "full"
              ]
            }
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeout_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "working_directory": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "verified_targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result_policy": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "STANDARD",
                  "DOCUMENTED_EXIT_CODES"
                ]
              },
              "did_not_execute_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "execution": {
            "type": "object",
            "required": [
              "allowed_contexts",
              "required_contexts"
            ],
            "properties": {
              "allowed_contexts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "LOCAL",
                    "CI",
                    "SPECIALIZED"
                  ]
                }
              },
              "required_contexts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "ANY",
                    "LOCAL",
                    "CI",
                    "SPECIALIZED"
                  ]
                }
              },
              "required_targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "context",
                    "os"
                  ],
                  "properties": {
                    "context": {
                      "enum": [
                        "LOCAL",
                        "CI",
                        "SPECIALIZED"
                      ]
                    },
                    "os": {
                      "type": "string",
                      "minLength": 1
                    },
                    "machine": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
