{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-governance/verification-report-v5.schema.json",
  "title": "Governed Verification Report v5 (target-aware)",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "plan_schema_version",
    "stage",
    "overall",
    "plan_sha256",
    "assurance_baseline_sha256",
    "generated_at_utc",
    "environment",
    "capability_preflight",
    "results",
    "execution_context",
    "runner_sha256",
    "git_worktree_dirty",
    "required_check_ids",
    "artifact_identities",
    "execution_target"
  ],
  "properties": {
    "schema_version": {
      "const": "5"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_schema_version": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "quick",
        "full"
      ]
    },
    "overall": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE_ASSURANCE"
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assurance_baseline_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at_utc": {
      "type": "string"
    },
    "git_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "ci": {
      "type": "boolean"
    },
    "environment": {
      "type": "object"
    },
    "capability_preflight": {
      "type": "object"
    },
    "results": {
      "type": "array"
    },
    "execution_context": {
      "enum": [
        "LOCAL",
        "CI",
        "SPECIALIZED"
      ]
    },
    "runner_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_worktree_dirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "required_check_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "artifact_identities": {
      "type": "object",
      "required": [
        "plan",
        "assurance_baseline",
        "runner"
      ],
      "properties": {
        "plan": {
          "type": "object",
          "required": [
            "source",
            "sha256",
            "working_tree_sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "GIT_HEAD",
                "WORKTREE_BYTES"
              ]
            },
            "repository_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "working_tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "assurance_baseline": {
          "type": "object",
          "required": [
            "source",
            "sha256",
            "working_tree_sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "GIT_HEAD",
                "WORKTREE_BYTES"
              ]
            },
            "repository_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "working_tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "runner": {
          "type": "object",
          "required": [
            "source",
            "sha256",
            "working_tree_sha256"
          ],
          "properties": {
            "source": {
              "enum": [
                "GIT_HEAD",
                "WORKTREE_BYTES"
              ]
            },
            "repository_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "working_tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ci_event_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "precondition_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_target": {
      "type": "object",
      "required": [
        "context",
        "os",
        "machine"
      ],
      "properties": {
        "context": {
          "enum": [
            "LOCAL",
            "CI",
            "SPECIALIZED"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "governance_integrity": {
      "type": [
        "object",
        "null"
      ],
      "description": "Cross-check of .governance/integrity.json and .governance/assurance-bootstrap.json against live bytes. Optional for backward compatibility with reports produced before this field existed; new reports from an updated runner always populate it.",
      "required": [
        "status",
        "issues",
        "checked"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "INCOMPLETE_ASSURANCE"
          ]
        },
        "issues": {
          "type": "array"
        },
        "checked": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "instruction_surface_audit": {
      "type": [
        "object",
        "null"
      ],
      "description": "Enumeration of project-level instruction surfaces not covered by the governance-managed blocks. Informational in professional mode; can produce UNAPPROVED_INSTRUCTION_SURFACE issues in business-led mode. Optional for backward compatibility with reports produced before this field existed.",
      "required": [
        "mode",
        "status",
        "surfaces",
        "issues"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "INCOMPLETE_ASSURANCE"
          ]
        },
        "surfaces": {
          "type": "array"
        },
        "issues": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": [
        "object",
        "null"
      ],
      "description": "Coverage-floor diagnostics for checks that declare a coverage block. Null when no selected check declares one. A below-floor measurement produces a COVERAGE_BELOW_DECLARED_FLOOR issue; a missing report is DID_NOT_EXECUTE on that diagnostic only, not on the check it decorates.",
      "required": [
        "status",
        "diagnostics",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "INCOMPLETE_ASSURANCE"
          ]
        },
        "diagnostics": {
          "type": "array"
        },
        "issues": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
